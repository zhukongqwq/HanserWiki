<Window x:Class="HanserWpf.WaitWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="请稍候" Width="400"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" SizeToContent="Height"
        Background="Transparent" FontFamily="Microsoft YaHei UI"
        ShowInTaskbar="False">
    <Border CornerRadius="14" Background="White" Margin="10" Padding="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.18" Color="#000000"/>
        </Border.Effect>
        <Grid Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <TextBlock x:Name="TitleText" Text="请稍候" FontSize="14" FontWeight="SemiBold"
                       Foreground="#374151"/>
            <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,2">
                <ProgressBar Width="150" Height="8" IsIndeterminate="True"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#E5E7EB" BorderThickness="0" VerticalAlignment="Center"/>
                <TextBlock x:Name="MessageText" Margin="14,0,0,0" FontSize="13"
                           Foreground="#4B5563" VerticalAlignment="Center" TextWrapping="Wrap"
                           MaxWidth="300"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
